{
  "name": "codindex",
  "version": "0.1.2",
  "description": "MCP server that indexes a codebase with tree-sitter into one SQLite file — functions, call graph, module deps, CFG, impact analysis, dead code. 32 tools, 6 languages, no LLM calls. For Claude Code, Cursor, VS Code.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "default": "./dist/mcp/server.js"
    },
    "./app": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "codindex": "./dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "codindex",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "code-index",
    "code-indexing",
    "codebase-index",
    "code-intelligence",
    "code-analysis",
    "static-analysis",
    "tree-sitter",
    "ast",
    "call-graph",
    "call-chain",
    "dependency-graph",
    "impact-analysis",
    "dead-code",
    "control-flow-graph",
    "sqlite",
    "fts5",
    "claude-code",
    "cursor",
    "ai-agents",
    "llm",
    "code-navigation",
    "code-search",
    "claude",
    "ai",
    "agent",
    "codebase",
    "vscode",
    "code-graph",
    "repo-index",
    "code-context",
    "agentic-coding",
    "codex",
    "windsurf",
    "claude-mcp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bencibr/codindex.git"
  },
  "homepage": "https://github.com/Bencibr/codindex#readme",
  "bugs": {
    "url": "https://github.com/Bencibr/codindex/issues"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.18",
    "@modelcontextprotocol/sdk": "^1.11.0",
    "better-sqlite3": "^11.8.1",
    "chalk": "^5.4.1",
    "chokidar": "^5.0.0",
    "drizzle-orm": "^0.41.0",
    "hono": "^4.7.7",
    "p-limit": "^6.2.0",
    "tree-sitter": "^0.22.4",
    "tree-sitter-go": "^0.23.4",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-python": "^0.23.6",
    "tree-sitter-rust": "^0.23.3",
    "tree-sitter-typescript": "^0.23.2",
    "uuid": "^11.1.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.14.1",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.30.6",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "author": "Codindex contributors"
}
